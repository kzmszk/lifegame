{
  "name": "lifegame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:worker": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "skill:zip": "mkdir -p dist && rm -f dist/morning-briefing.zip && cd skills && zip -qr ../dist/morning-briefing.zip morning-briefing -x 'morning-briefing/INSTALL.md'"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.8.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.20.0",
    "hono": "^4.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "wrangler": "^4.11.1"
  }
}
