{
  "name": "lifegame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:worker": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "skill:zip": "mkdir -p dist && rm -f dist/morning-briefing.zip && cd skills && zip -qr ../dist/morning-briefing.zip morning-briefing -x 'morning-briefing/INSTALL.md'"
  },
  "engines": {
    "node": "^22.22.1 || >=24"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "oxfmt",
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern"
    ],
    "*.{css,html,json,jsonc,md,yaml,yml}": "oxfmt"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.8.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.20.0",
    "hono": "^4.7.2",
    "jose": "^6.2.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "wrangler": "^4.11.1"
  }
}
