{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifegame",
  "main": "src/index.ts",
  // workers.dev と Preview URL は Access の対象外になりうるため無効化している。
  // そのぶん公開ホスト名は routes で明示する必要がある: 下の routes を自分のドメインに
  // 置き換えてから deploy すること (未設定のままだと公開ホスト名のない Worker になる)。
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "lifegame.example.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/.well-known/*",
      "/register",
      "/token",
      "/authorize"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifegame",
      // Replace this local placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Replace this local placeholder with the ID returned by `wrangler kv namespace create OAUTH_KV` before deploying.
      "id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "LifegameMcp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LifegameMcp"]
    }
  ],
  // Production is authenticated by default. Local development overrides this in .dev.vars.
  "vars": {
    "AUTH_REQUIRED": "true"
  }
}
