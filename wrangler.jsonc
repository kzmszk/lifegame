{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifegame",
  "main": "src/index.ts",
  // workers.dev と Preview URL は Access の対象外になりうるため無効化している。
  // そのぶん公開ホスト名は routes で明示する必要がある。
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "lifegame.tachicoma.com",
      "custom_domain": true,
    },
  ],
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build",
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/.well-known/*",
      "/register",
      "/token",
      "/authorize",
      "/csp-report",
    ],
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifegame",
      "database_id": "add71ef2-9c9c-44cb-acc6-5e24f987f741",
      "migrations_dir": "./migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "54391d80a5ff4fe592f08c08d784cae1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "LifegameMcp",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LifegameMcp"],
    },
  ],
  // Production is authenticated by default. Local development overrides this in .dev.vars.
  "vars": {
    "AUTH_REQUIRED": "true",
    // Replace both placeholders with the values from the protected Access application before deploying.
    "ACCESS_TEAM_DOMAIN": "REPLACE_BEFORE_DEPLOY_ACCESS_TEAM_DOMAIN",
    "ACCESS_AUD": "REPLACE_BEFORE_DEPLOY_ACCESS_AUD",
  },
}
