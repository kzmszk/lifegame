{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifegame",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifegame",
      // Replace this local placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  // Production is authenticated by default. Local development overrides this in .dev.vars.
  "vars": {
    "AUTH_REQUIRED": "true"
  }
}
